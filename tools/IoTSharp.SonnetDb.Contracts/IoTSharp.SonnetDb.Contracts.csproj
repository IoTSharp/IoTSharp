<Project>
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <SonnetDbContractsPackageVersion Condition="'$(SonnetDbContractsPackageVersion)' == ''">5.0.0</SonnetDbContractsPackageVersion>
    <SonnetDbContractsEfCoreVersion Condition="'$(SonnetDbContractsEfCoreVersion)' == ''">10.0.14</SonnetDbContractsEfCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SonnetDB" Version="[$(SonnetDbContractsPackageVersion)]" />
    <PackageReference Include="SonnetDB.EntityFrameworkCore" Version="[$(SonnetDbContractsPackageVersion)]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[$(SonnetDbContractsEfCoreVersion)]" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
